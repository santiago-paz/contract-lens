generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ── Organization (top-level tenant) ────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     Membership[]
  teams       Team[]
  contracts   Contract[]
  invitations Invitation[]
}

// ── Membership (User <-> Organization + role) ──────────────────────────────

model Membership {
  id             String       @id @default(cuid())
  role           String       @default("member") // owner | admin | manager | member | viewer
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

// ── Invitation ─────────────────────────────────────────────────────────────

model Invitation {
  id             String    @id @default(cuid())
  email          String
  role           String    @default("member")
  token          String    @unique @default(cuid())
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedById    String
  invitedBy      User         @relation("InvitationsSent", fields: [invitedById], references: [id])

  @@unique([email, organizationId])
}

// ── User ───────────────────────────────────────────────────────────────────

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  password        String
  name            String?
  avatar          String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  memberships     Membership[]
  teamMembers     TeamMember[]
  contracts       Contract[]
  tasks           Task[]
  activities      Activity[]
  alertsCreated   Alert[]         @relation("AlertsCreated")
  alertResponses  AlertResponse[] @relation("AlertResponses")
  alertEvents     AlertEvent[]    @relation("AlertEvents")
  invitationsSent Invitation[]    @relation("InvitationsSent")
}

// ── Team ───────────────────────────────────────────────────────────────────

model Team {
  id             String       @id @default(cuid())
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  members        TeamMember[]

  @@unique([name, organizationId])
  @@index([organizationId])
}

// ── TeamMember (User <-> Team) ─────────────────────────────────────────────

model TeamMember {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
}

// ── Contract ───────────────────────────────────────────────────────────────

model Contract {
  id              String   @id @default(cuid())
  contractNumber  String // unique per organization (see @@unique below)
  title           String
  type            String // e.g. "NDA", "ServiceAgreement", "LicenseAgreement", "Other"
  status          String   @default("Draft") // e.g. "Active", "Review", "Draft"

  // ── Core metadata ──────────────────────────────────────────────────────
  category        String?
  summary         String?  @db.Text
  conditions      String?  @db.Text
  comments        String?  @db.Text
  contractOwner   String?
  deputy          String?
  contractManager String?
  contractPartner String?
  contractValue   String?
  confidentiality String?
  durationType    String?
  organizationalUnit String?
  riskAssessment  String?
  liabilityAmount String?

  // ── Dates ──────────────────────────────────────────────────────────────
  startDate       String?  // effectiveDate / contractStart
  endDate         String?  // expirationDate / terminationDate
  renewalDate     String?

  // ── Parties ────────────────────────────────────────────────────────────
  parties         Json?    // String[] — full legal names from extraction

  // ── NDA-specific ───────────────────────────────────────────────────────
  confidentialityDuration String?
  isMutual        Boolean?
  jurisdiction    String?
  riskFlags       Json?    // { nonSolicit, nonCompete, liquidatedDamages }

  // ── Service Agreement-specific ─────────────────────────────────────────
  autoRenewal     Boolean?
  paymentTerms    Json?    // { method, timing, currency }
  ipOwnership     String?
  terminationNoticePeriod String?
  liabilityCap    String?
  indemnification String?

  // ── License Agreement-specific ─────────────────────────────────────────
  licensor        String?
  licensee        String?
  softwareName    String?
  licenseType     String?
  usageLimits     String?
  exclusivity     Boolean?
  auditRights     Json?    // { canAudit, noticePeriod }
  territory       String?

  // ── General / Other ────────────────────────────────────────────────────
  governingLaw    String?
  keyDates        Json?    // [{ label, date }]

  // ── File / Content ─────────────────────────────────────────────────────
  fileName        String?
  content         String?  @db.Text // Extracted text or editor content
  fileData        Bytes?   // Actual file content if needed

  userId          String
  user            User     @relation(fields: [userId], references: [id])

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tasks           Task[]
  alerts          Alert[]
  activities      Activity[]

  @@unique([contractNumber, organizationId])
  @@index([organizationId, updatedAt(sort: Desc)], map: "idx_contract_org_updated")
  @@index([userId, updatedAt(sort: Desc)], map: "idx_contract_user_updated")
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String // e.g. "Open"
  type        String? // e.g. "License Agreement"
  dueDate     DateTime?
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  contractId  String?
  contract    Contract? @relation(fields: [contractId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Activity {
  id          String   @id @default(cuid())
  description String
  action      String // e.g. "created", "updated", "restored", "deleted"
  timestamp   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  contractId  String?
  contract    Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
}

// ── Alerts / Alarms ────────────────────────────────────────────────────────────

model Alert {
  id            String          @id @default(cuid())
  alarmDate     DateTime        @default(now())
  deadline      DateTime?
  deadlineLabel String?         // "Enddatum", "Verlängerung", etc.
  status        String          @default("open_no_answer") // open_no_answer | open_with_answer | escalating | closed
  note          String?         @db.Text

  contractId    String
  contract      Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  createdById   String
  createdBy     User            @relation("AlertsCreated", fields: [createdById], references: [id])

  response      AlertResponse?
  events        AlertEvent[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model AlertResponse {
  id            String   @id @default(cuid())
  responseType  String   // "continue" | "terminate" | "question"
  comment       String?  @db.Text

  alertId       String   @unique
  alert         Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  respondedById String
  respondedBy   User     @relation("AlertResponses", fields: [respondedById], references: [id])

  createdAt     DateTime @default(now())
}

model AlertEvent {
  id          String   @id @default(cuid())
  eventType   String   // "alarmed" | "responded" | "escalated" | "closed"
  description String?

  alertId     String
  alert       Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("AlertEvents", fields: [userId], references: [id])

  createdAt   DateTime @default(now())
}
