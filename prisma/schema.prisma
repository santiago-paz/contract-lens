generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id         String     @id @default(cuid())
  email      String     @unique
  password   String
  name       String?
  avatar     String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  teamId     String?
  team       Team?      @relation(fields: [teamId], references: [id])
  contracts  Contract[]
  tasks      Task[]
  activities Activity[]
}

model Team {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model Contract {
  id              String   @id @default(cuid())
  contractNumber  String   @unique // displayed ID e.g. "10023"
  title           String
  type            String // e.g. "NDA", "ServiceAgreement", "LicenseAgreement", "Other"
  status          String   @default("Draft") // e.g. "Active", "Review", "Draft"
  
  // ── Core metadata ──────────────────────────────────────────────────────
  summary         String?  @db.Text
  conditions      String?  @db.Text
  comments        String?  @db.Text
  contractOwner   String?
  deputy          String?
  contractManager String?
  contractPartner String?
  contractValue   String?
  confidentiality String?
  durationType    String?
  organizationalUnit String?
  riskAssessment  String?
  liabilityAmount String?

  // ── Dates ──────────────────────────────────────────────────────────────
  startDate       String?  // effectiveDate / contractStart
  endDate         String?  // expirationDate / terminationDate
  renewalDate     String?

  // ── Parties ────────────────────────────────────────────────────────────
  parties         Json?    // String[] — full legal names from extraction

  // ── NDA-specific ───────────────────────────────────────────────────────
  confidentialityDuration String?
  isMutual        Boolean?
  jurisdiction    String?
  riskFlags       Json?    // { nonSolicit, nonCompete, liquidatedDamages }

  // ── Service Agreement-specific ─────────────────────────────────────────
  autoRenewal     Boolean?
  paymentTerms    Json?    // { method, timing, currency }
  ipOwnership     String?
  terminationNoticePeriod String?
  liabilityCap    String?
  indemnification String?

  // ── License Agreement-specific ─────────────────────────────────────────
  licensor        String?
  licensee        String?
  softwareName    String?
  licenseType     String?
  usageLimits     String?
  exclusivity     Boolean?
  auditRights     Json?    // { canAudit, noticePeriod }
  territory       String?

  // ── General / Other ────────────────────────────────────────────────────
  governingLaw    String?
  keyDates        Json?    // [{ label, date }]

  // ── File / Content ─────────────────────────────────────────────────────
  fileName        String?
  content         String?  @db.Text // Extracted text or editor content
  fileData        Bytes?   // Actual file content if needed
  
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tasks           Task[]
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String // e.g. "Open"
  type        String? // e.g. "License Agreement"
  dueDate     DateTime?
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  contractId  String?
  contract    Contract? @relation(fields: [contractId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Activity {
  id          String   @id @default(cuid())
  description String
  action      String // e.g. "created", "updated", "restored", "deleted"
  timestamp   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}
